    <parent link="arm_l2"/>
    <child link="closing_tip_2_z"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- Joint from rotor to arm_l2 (passive, imposed by FiveBarClosurePlugin).
       axis flipped to "0 0 -1" vs the CAD export; see header, delta 2. -->
  <joint name="passive_1" type="continuous">
    <origin xyz="0 -0.06 -0.035" rpy="-0 0 -0.212054"/>
    <parent link="rotor"/>
    <child link="arm_l2"/>
    <axis xyz="0 0 -1"/>
    <limit effort="10" velocity="10"/>
  </joint>

  <!-- Joint from case to rotor (actuated, theta1) -->
  <joint name="motor_1" type="continuous">
    <origin xyz="-0.0421006 0.0302628 0.00805311" rpy="-3.14159 0 0.662203"/>
    <parent link="case"/>
    <child link="rotor"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10"/>
  </joint>

  <!-- Link rotor_2 (right crank: motor rotor + arm_r1) -->
  <link name="rotor_2">
    <inertial>
      <origin xyz="0 -0.00413346 -0.012052" rpy="0 0 0"/>
      <mass value="0.0348226"/>
      <inertia ixx="1.09011e-05" ixy="-0" ixz="-0" iyy="4.78125e-06" iyz="-1.35457e-06" izz="1.24874e-05"/>
    </inertial>
    <!-- Part arm_r1 -->
    <visual>
      <origin xyz="0 -0.06 -0.019" rpy="3.14159 -0 -1.5708"/>
      <geometry>
