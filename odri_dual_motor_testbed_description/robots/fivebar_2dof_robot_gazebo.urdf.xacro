<?xml version="1.0" ?>
<robot name="fivebar_2dof" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ROS namespace injected into the odri_gz_ros2_control plugin's <ros><namespace>
       element, so that several instances of this robot can be spawned in the same
       Gazebo world, each with its own controller_manager/topics (see
       odri_dual_motor_testbed_haptic_pair). Empty by default: unnamespaced,
       single-robot behaviour is unchanged. -->
  <xacro:arg name="robot_namespace" default=""/>
  <!-- Controller manager parameters file loaded by the odri_gz_ros2_control
       plugin. Defaults to the single-robot forward-command-controller setup
       used by odri_dual_motor_testbed_gazebo; override to load a different
       controller set (e.g. odri_five_bar_force_velocity_controller for the
       haptic pair). -->
  <xacro:arg name="controller_params_file"
             default="$(find odri_dual_motor_testbed_gazebo)/config/forward_command_controller.yaml"/>
  <link name="world"/>

  <!-- The ros2_control block, the odri_gz_ros2_control plugin and the
       FiveBarClosurePlugin all live in fivebar_2dof.urdf.xacro, so this file
       only anchors the robot to the world. -->
  <xacro:include filename="$(find odri_dual_motor_testbed_description)/urdf/fivebar_2dof.urdf.xacro" />

  <!-- base_link is the dummy root of the CAD export; `case` is rigidly
       attached to it and carries the actual base mass. -->
  <joint name="base_link_in_world" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0.0 0.0 0.001" rpy ="0.0 0.0 0.0"/>
  </joint>


    <ros2_control name="GazeboOdriSimSystem" type="system">
    <hardware>
      <plugin>odri_gz_ros2_control/GazeboOdriSimSystem</plugin>
    </hardware>
    <joint name="motorL">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <command_interface name="gain_kp" />
      <command_interface name="gain_kd" />
      <state_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="effort" />
    </joint>
    <joint name="motorR">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <command_interface name="gain_kp" />
      <command_interface name="gain_kd" />
      <state_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="effort" />
    </joint>

    <joint name="elbowL">
      <state_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="effort" />
    </joint>

    <joint name="elbowR">
      <state_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="effort" />
    </joint>

  </ros2_control>

  <gazebo>
    <plugin filename="odri_gz_ros2_control-system" name="odri_gz_ros2_control::GazeboOdriSimROS2ControlPlugin">
      <parameters>$(arg controller_params_file)</parameters>
      <ros>
        <namespace>$(arg robot_namespace)</namespace>
      </ros>
    </plugin>
  </gazebo>

  <!-- ================================================================ -->
  <!--      Gazebo Harmonic (gz-sim8) system plugin for five-bar loop closure. -->
  <!--      Exact direct geometric model: reads motorL/motorR and imposes -->
  <!--      elbowL/elbowR via Joint::ResetPosition every step. -->
  <!--      See five_bar_mgd_spec.md at the repository root. -->
  <!--      ================================================================ -->
  <gazebo>
    <plugin filename="libFiveBarClosurePlugin.so"
            name="odri_gz::FiveBarClosurePlugin">
      <!-- Actuated joints (inputs, theta1/theta2). -->
      <motor_joint1>motorL</motor_joint1>
      <motor_joint2>motorR</motor_joint2>
      <!-- Passive joints (outputs, beta1/beta2), imposed exactly. -->
      <elbow_joint1>elbowL</elbow_joint1>
      <elbow_joint2>elbowR</elbow_joint2>
      <!-- Geometry parameters (verified numerically, see
           five_bar_mgd_spec.md section 2). -->
      <a_x>-0.065</a_x>
      <a_z>0</a_z>
      <b_x>0.065</b_x>
      <b_z>0</b_z>
      <l1>0.06</l1>
      <l2>0.125</l2>
      <phi1>3.14159265358979323846</phi1>
      <phi2>1.9504681943696776</phi2>
      <psi1>1.1061036468685321</psi1>
      <psi2>2.6769066384729094</psi2>
    </plugin>
  </gazebo>

</robot>
