    <collision>
      <origin xyz="0 -0.06 -0.03" rpy="3.14159 -0 -1.5708"/>
      <geometry>
        <mesh filename="package://odri_dual_motor_testbed_description/meshes/assets/five_bar/arm_l1.stl"/>
      </geometry>
      <surface>
        <contact>
          <collide_bitmask>0x04</collide_bitmask>
