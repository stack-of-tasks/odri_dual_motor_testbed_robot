<!-- Expects the including robot file to declare the xacro args
     controller_params_file (controller_manager YAML loaded by
     motkin_gz_ros2_control) and robot_namespace. -->
<xacro:macro name="motkin_dual_motor_testbed_gazebo">
  <ros2_control name="GazeboMotkinSimSystem" type="system">
    <hardware>
      <plugin>motkin_gz_ros2_control/GazeboMotkinSimSystem</plugin>
    </hardware>
    <joint name="motor_1">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <command_interface name="gain_kp" />
      <command_interface name="gain_kd" />
      <state_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="effort" />
    </joint>
    <joint name="motor_2">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <command_interface name="gain_kp" />
      <command_interface name="gain_kd" />
      <state_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="effort" />
    </joint>

    <!-- Simulated motkin board status. clock is the simulation time in us,
         latest_command_index counts physics steps, and flags is set by
         publishing a gz.msgs.UInt32 (0-255) on flags_topic, which is
         prefixed by robot_namespace so that each robot gets its own, e.g.
         gz topic -t /<robot_namespace>/motkin_board/flags -m gz.msgs.UInt32 -p 'data: 4' -->
    <xacro:property name="flags_ns" value="${'$(arg robot_namespace)'.strip('/')}" />
    <gpio name="motkin_board">
      <param name="flags_topic">${'/' + flags_ns if flags_ns else ''}/motkin_board/flags</param>
      <state_interface name="clock" data_type="uint32" />
      <state_interface name="latest_command_index" data_type="uint32" />
      <state_interface name="flags" data_type="uint8" />
    </gpio>
  </ros2_control>

  <gazebo>
    <plugin filename="motkin_gz_ros2_control-system" name="motkin_gz_ros2_control::GazeboMotkinSimROS2ControlPlugin">
      <parameters>$(arg controller_params_file)</parameters>
      <ros>
        <namespace>$(arg robot_namespace)</namespace>
      </ros>
   </plugin>
  </gazebo>

  <!-- ================================================================ -->
  <!--      Collision filtering. Contacts only occur between two collisions -->
  <!--      whose collide_bitmask values share a bit. These must be set here, -->
  <!--      through <gazebo reference>: a <surface> tag inside a URDF -->
  <!--      <collision> is dropped by the URDF to SDF conversion. -->
  <!--      The base is welded to the world: without mask 0 its meshes touch -->
  <!--      the ground plane and the contact computation slows the simulation -->
  <!--      down about 50 times. -->
  <!--      ================================================================ -->
  <!-- Base, welded to the world: no contact. -->
  <gazebo reference="case">
    <collision><surface><contact><collide_bitmask>0x00</collide_bitmask></contact></surface></collision>
  </gazebo>
  <!-- Base, welded to the world: no contact. -->
  <gazebo reference="top_cover">
    <collision><surface><contact><collide_bitmask>0x00</collide_bitmask></contact></surface></collision>
  </gazebo>
  <!-- Left flywheel. -->
  <gazebo reference="rotor">
    <collision><surface><contact><collide_bitmask>0x04</collide_bitmask></contact></surface></collision>
  </gazebo>
  <!-- Right flywheel. -->
  <gazebo reference="rotor_2">
    <collision><surface><contact><collide_bitmask>0x08</collide_bitmask></contact></surface></collision>
  </gazebo>
  </xacro:macro>
</robot>
