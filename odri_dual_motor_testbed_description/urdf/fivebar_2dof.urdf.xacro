      <geometry>
        <mesh filename="package://odri_dual_motor_testbed_description/meshes/assets/five_bar/foot.stl"/>
      </geometry>
      <material name="foot_4_material">
        <color rgba="0.231373 0.380392 0.705882 1"/>
