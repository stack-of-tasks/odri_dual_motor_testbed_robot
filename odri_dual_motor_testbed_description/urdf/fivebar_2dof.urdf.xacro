  <!-- Link arm_l2 (left coupler) -->
  <link name="arm_l2">
    <inertial>
      <origin xyz="0.0486799 0 -0.00203243" rpy="0 0 0"/>
      <mass value="0.00836663"/>
      <inertia ixx="1.67009e-07" ixy="0" ixz="2.2447e-08" iyy="1.30505e-05" iyz="0" izz="1.31626e-05"/>
