      </geometry>
    </collision>
  </link>

  <!-- Link rotor (left crank: motor rotor + arm_l1) -->
  <link name="rotor">
    <inertial>
      <origin xyz="-0 -0.00341447 -0.0160121" rpy="0 0 0"/>
      <mass value="0.0421552"/>
      <inertia ixx="1.42858e-05" ixy="0" ixz="-0" iyy="8.06252e-06" iyz="-2.36787e-06" izz="1.35352e-05"/>
