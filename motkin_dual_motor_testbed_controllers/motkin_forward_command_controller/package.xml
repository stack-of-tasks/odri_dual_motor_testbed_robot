<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>motkin_forward_command_controller</name>
  <version>1.1.0</version>
  <description>Forward command controller for MOTKIN joints that sends position, velocity, effort, gain_kp and gain_kd commands together via a single topic using std_msgs/Float64MultiArray. The flat data array is ordered as: [pos×n | vel×n | eff×n | gain_kp×n | gain_kd×n] for n joints. Per-value NaN entries are silently skipped for partial updates.</description>
  <maintainer email="guilhem.saurel@laas.fr">Guilhem Saurel</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/Gepetto/motkin-dual-motor-testbed-robot</url>
  <author email="olivier.stasse@laas.fr">Olivier Stasse</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- <buildtool_depend>python3-rosdoc2</buildtool_depend> -->

  <depend>controller_interface</depend>
  <depend>generate_parameter_library</depend>
  <depend>hardware_interface</depend>
  <depend>motkin_dual_motor_testbed_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>std_msgs</depend>

  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_cmake_gmock</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
