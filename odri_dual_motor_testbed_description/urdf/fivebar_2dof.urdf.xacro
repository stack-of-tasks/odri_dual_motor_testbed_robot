      <geometry>
        <mesh filename="package://odri_dual_motor_testbed_description/meshes/assets/five_bar/arm_r1.stl"/>
      </geometry>
      <surface>
        <contact>
          <collide_bitmask>0x08</collide_bitmask>
        </contact>
      </surface>
    </collision>
    <!-- Part rotor_2 -->
    <visual>
      <origin xyz="0 0 0.007" rpy="3.14159 -0 -0"/>
      <geometry>
        <mesh filename="package://odri_dual_motor_testbed_description/meshes/assets/five_bar/rotor.stl"/>
      </geometry>
      <material name="rotor_2_material">
