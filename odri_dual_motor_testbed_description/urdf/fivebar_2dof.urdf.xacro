      </geometry>
      <surface>
        <contact>
          <collide_bitmask>0x02</collide_bitmask>
        </contact>
      </surface>
    </collision>
  </link>

  <!-- Frame closing_tip_1 (dummy link + fixed joint) -->
  <link name="closing_tip_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="closing_tip_1_frame" type="fixed">
    <origin xyz="0.0589379 -0.0807857 -0.011" rpy="-3.14159 0 -0.940506"/>
    <parent link="arm_r2"/>
    <child link="closing_tip_1"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- Frame closing_tip_1_z (dummy link + fixed joint) -->
  <link name="closing_tip_1_z">
