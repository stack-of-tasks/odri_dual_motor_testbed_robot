<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>motkin_dual_motor_testbed_robot</name>
  <version>1.0.1</version>
  <description>Meta package describing the MOTKIN dual motor testbed robot</description>
  <maintainer email="guilhem.saurel@laas.fr">Guilhem Saurel</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/Gepetto/motkin-dual-motor-testbed-robot</url>
  <author email="olivier.stasse@laas.fr">Olivier Stasse</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- <buildtool_depend>python3-rosdoc2</buildtool_depend> -->

  <!-- We need the xacro package to build the urdf model -->
  <build_depend> xacro </build_depend>
  <exec_depend>   xacro </exec_depend>
  <depend>controller_manager</depend>

  <exec_depend>motkin_dual_motor_testbed_description</exec_depend>
  <exec_depend>motkin_dual_motor_testbed_bringup</exec_depend>

  <!-- keep-sorted start -->
  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <!-- keep-sorted end -->

  <export>
      <build_type>ament_cmake</build_type>
  </export>
</package>
