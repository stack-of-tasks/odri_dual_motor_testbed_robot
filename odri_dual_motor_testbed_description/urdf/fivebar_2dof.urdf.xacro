      <origin xyz="0.00789938 0.0102628 -0.00394689" rpy="0 -0 0"/>
      <geometry>
        <mesh filename="package://odri_dual_motor_testbed_description/meshes/assets/five_bar/top_cover.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint from base_link to top_cover -->
  <joint name="base_link_to_top_cover" type="fixed">
    <origin xyz="0 0 0" rpy="0 -0 0"/>
    <parent link="base_link"/>
    <child link="top_cover"/>
    <axis xyz="0 0 1"/>
  </joint>

  <ros2_control name="GazeboOdriSimSystem" type="system">
    <hardware>
      <plugin>odri_gz_ros2_control/GazeboOdriSimSystem</plugin>
    </hardware>
    <joint name="motor_1">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <command_interface name="gain_kp" />
      <command_interface name="gain_kd" />
      <state_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="effort" />
    </joint>
    <joint name="motor_2">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <command_interface name="gain_kp" />
      <command_interface name="gain_kd" />
      <state_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="effort" />
    </joint>

    <joint name="passive_1">
      <state_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="effort" />
    </joint>

    <joint name="passive_2">
      <state_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="effort" />
    </joint>

  </ros2_control>

  <gazebo>
    <plugin filename="odri_gz_ros2_control-system" name="odri_gz_ros2_control::GazeboOdriSimROS2ControlPlugin">
      <parameters>$(arg controller_params_file)</parameters>
      <ros>
        <namespace>$(arg robot_namespace)</namespace>
      </ros>
    </plugin>
  </gazebo>

  <!-- ================================================================ -->
  <!--      Gazebo Harmonic (gz-sim8) system plugin for five-bar loop closure. -->
  <!--      Exact direct geometric model: reads motor_1/motor_2 and imposes -->
  <!--      passive_1/passive_2 via Joint::ResetPosition every step. -->
  <!--      See five_bar_mgd_spec.md at the repository root. -->
  <!--      ================================================================ -->
  <gazebo>
    <plugin filename="libFiveBarClosurePlugin.so"
            name="odri_gz::FiveBarClosurePlugin">
      <!-- Actuated joints (inputs, theta1/theta2). -->
      <motor_joint1>motor_1</motor_joint1>
      <motor_joint2>motor_2</motor_joint2>
      <!-- Passive joints (outputs, beta1/beta2), imposed exactly. -->
      <elbow_joint1>passive_1</elbow_joint1>
      <elbow_joint2>passive_2</elbow_joint2>
      <!-- Geometry parameters, re-derived from MOTKINBENCH robot.urdf and
