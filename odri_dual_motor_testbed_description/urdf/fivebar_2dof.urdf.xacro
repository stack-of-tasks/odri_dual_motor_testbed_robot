    <origin xyz="0.0589379 -0.0807857 -0.111" rpy="-3.14159 0 -0.940506"/>
    <parent link="arm_r2"/>
    <child link="closing_tip_1_z"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- Joint from rotor_2 to arm_r2 (passive, imposed by FiveBarClosurePlugin).
       axis flipped to "0 0 -1" vs the CAD export; see header, delta 2. -->
  <joint name="passive_2" type="continuous">
    <origin xyz="0 -0.06 -0.024" rpy="-0 -0 -1.5708"/>
    <parent link="rotor_2"/>
    <child link="arm_r2"/>
    <axis xyz="0 0 -1"/>
    <limit effort="10" velocity="10"/>
  </joint>

  <!-- Joint from case to rotor_2 (actuated, theta2) -->
  <joint name="motor_2" type="continuous">
    <origin xyz="0.0578994 0.0302628 0.00805311" rpy="3.14159 0 -0.0662491"/>
    <parent link="case"/>
    <child link="rotor_2"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10"/>
  </joint>

  <!-- Joint from base_link to case -->
  <joint name="base_link_to_case" type="fixed">
    <origin xyz="0 0 0" rpy="0 -0 0"/>
    <parent link="base_link"/>
    <child link="case"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Link top_cover -->
  <link name="top_cover">
    <inertial>
      <origin xyz="0.00788351 0.00728336 0.0185531" rpy="0 0 0"/>
      <mass value="0.0649221"/>
      <inertia ixx="7.68894e-05" ixy="-4.728e-08" ixz="0" iyy="0.000165678" iyz="0" izz="0.00024247"/>
    </inertial>
    <!-- Part top_cover -->
    <visual>
      <origin xyz="0.00789938 0.0102628 -0.00394689" rpy="0 -0 0"/>
      <geometry>
        <mesh filename="package://odri_dual_motor_testbed_description/meshes/assets/five_bar/top_cover.stl"/>
      </geometry>
      <material name="top_cover_material">
        <color rgba="0.941176 0.87451 0.678431 0.231373"/>
