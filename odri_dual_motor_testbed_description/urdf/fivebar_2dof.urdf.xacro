  <!-- Link arm_r2 (right coupler) -->
  <link name="arm_r2">
    <inertial>
      <origin xyz="0.0328205 -0.0449868 -0.00311181" rpy="0 0 0"/>
      <mass value="0.00968954"/>
      <inertia ixx="1.06339e-05" ixy="7.56672e-06" ixz="2.86385e-07" iyy="5.7826e-06" iyz="-3.92545e-07" izz="1.62905e-05"/>
    </inertial>
    <!-- Part arm_r2 -->
    <visual>
      <origin xyz="0 0 -0.0005" rpy="-3.14159 0 -0.940506"/>
      <geometry>
