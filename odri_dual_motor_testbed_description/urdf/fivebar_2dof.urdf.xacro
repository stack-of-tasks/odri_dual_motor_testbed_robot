<?xml version="1.0" ?>
<!-- Generated using onshape-to-robot, then adapted for ros2_control/Gazebo. -->
<!-- Onshape https://cad.onshape.com/documents/581c9cc37f21d16430f878db/w/71943bc1e21e09c7efc95c4d/e/f006a340564aa87bd0b132ba -->
<!--
  Source of truth: MOTKINBENCH/urdf/five_bar/robot.urdf (+ assets/, config.json).
  Regenerate that file with onshape-to-robot, then re-apply the deltas listed
  below; the meshes are mirrored under meshes/assets/five_bar/.

  Deltas applied on top of the raw onshape-to-robot export:

  1. Mesh paths rewritten from package://assets/<x>.stl to
     package://odri_dual_motor_testbed_description/meshes/assets/five_bar/<x>.stl.
  2. passive_1 / passive_2 use axis "0 0 -1" instead of the exported "0 0 1".
     In this CAD the passive joints carry no roll flip relative to their
     parent rotor, so they turn in the SAME sense as the motors, whereas the
     previous mechanism's elbows turned the opposite way. FiveBarClosurePlugin
     (and the analytical model in five_bar_mgd_spec.md) computes
     beta = atan2(P - E) - psi + theta, which assumes the opposite sense.
     Flipping the axis here restores that convention exactly; verified
     numerically: worst loop-closure residual 6.6e-07 m over theta in
     [-0.7, 0.7]^2, versus 9.6e-02 m with the exported axis.
  3. The stray empty link c_0402_1005metric (a KiCad footprint that leaked
     into the CAD assembly; 1e-9 mass, no visual, no collision) is dropped.
  4. collide_bitmask surface tags added on the four moving links, carried over
     from the previous revision of this file, so the arms never self-collide.
  5. ros2_control + Gazebo plugin blocks appended (not part of the export).

  NOTE on orientation: the mechanism plane is the (x,y) plane of `case`, with
  both motor axes along -z. With the base plate flat on the ground this is a
  HORIZONTAL five-bar. The previous mechanism was a vertical one (plane (x,z)
  of base_asm, axes along y). Gravity therefore no longer produces any
  in-plane torque; see the gravity_compensation_enabled defaults in
  odri_dual_motor_testbed_controllers.
-->
<robot name="fivebar_2dof" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ROS namespace injected into the odri_gz_ros2_control plugin's <ros><namespace>
       element, so that several instances of this robot can be spawned in the same
       Gazebo world, each with its own controller_manager/topics (see
       odri_dual_motor_testbed_haptic_pair). Empty by default: unnamespaced,
       single-robot behaviour is unchanged. -->
  <xacro:arg name="robot_namespace" default=""/>
  <!-- $(arg controller_params_file) is consumed below but declared by the
       including robot file (robots/fivebar_2dof_robot_gazebo.urdf.xacro),
       which owns the choice of controller set. -->

  <!-- Link base_link (dummy root, add_dummy_base_link in config.json) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-09"/>
      <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09"/>
    </inertial>
  </link>

  <!-- Link case -->
  <link name="case">
    <inertial>
      <origin xyz="0.00789938 0.0135971 0.00225065" rpy="0 0 0"/>
      <mass value="0.193781"/>
      <inertia ixx="0.000289186" ixy="0" ixz="0" iyy="0.000652997" iyz="-1.98334e-06" izz="0.000927223"/>
    </inertial>
    <!-- Part foot -->
    <visual>
      <origin xyz="0.00789938 0.0102628 -0.00394689" rpy="0 -0 0"/>
      <geometry>
        <mesh filename="package://odri_dual_motor_testbed_description/meshes/assets/five_bar/foot.stl"/>
      </geometry>
      <material name="foot_material">
        <color rgba="0.231373 0.380392 0.705882 1"/>
      </material>
    </visual>
    <collision>
